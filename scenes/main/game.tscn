[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/systems/game_session.gd" id="1_game"]
[ext_resource type="PackedScene" path="res://scenes/world/city.tscn" id="2_block"]
[ext_resource type="PackedScene" path="res://scenes/player/player.tscn" id="3_player"]
[ext_resource type="PackedScene" path="res://scenes/ui/hud.tscn" id="4_hud"]
[ext_resource type="PackedScene" path="res://scenes/ui/pause_menu.tscn" id="5_pause"]
[ext_resource type="Script" path="res://scripts/vehicles/vehicle_camera.gd" id="6_vcam"]
[ext_resource type="Resource" path="res://resources/vehicles/vehicle_camera.tres" id="7_vcamset"]
[ext_resource type="Script" path="res://scripts/systems/camera_transition.gd" id="8_transition"]
[ext_resource type="Script" path="res://scripts/world/lane_graph_debug.gd" id="9_lanedebug"]
[ext_resource type="Script" path="res://scripts/npc/traffic_manager.gd" id="10_traffic"]
[ext_resource type="Script" path="res://scripts/npc/pedestrian_manager.gd" id="11_peds"]
[ext_resource type="Resource" path="res://resources/characters/population.tres" id="12_population"]
[ext_resource type="Resource" path="res://resources/vehicles/traffic_driver.tres" id="13_driver"]
[ext_resource type="PackedScene" path="res://scenes/vehicles/sedan.tscn" id="14_sedan"]
[ext_resource type="PackedScene" path="res://scenes/npc/pedestrian.tscn" id="15_ped"]
[ext_resource type="PackedScene" path="res://assets/models/characters/chr_ped_man.glb" id="16_man"]
[ext_resource type="PackedScene" path="res://assets/models/characters/chr_ped_woman.glb" id="17_woman"]
[ext_resource type="PackedScene" path="res://assets/models/characters/chr_ped_elder.glb" id="18_elder"]
[ext_resource type="Script" path="res://scripts/missions/mission_director.gd" id="19_missions"]
[ext_resource type="Script" path="res://scripts/ui/mission_failed_screen.gd" id="20_failed"]
[ext_resource type="Script" path="res://scripts/world/day_night_cycle.gd" id="21_daynight"]
[ext_resource type="Resource" path="res://resources/world/day_night.tres" id="22_daynight_settings"]
[ext_resource type="Script" path="res://scripts/world/gps_navigator.gd" id="23_gps"]
[ext_resource type="Script" path="res://scripts/ui/map_screen.gd" id="24_map"]
[ext_resource type="Script" path="res://scripts/police/police_manager.gd" id="25_police"]
[ext_resource type="Script" path="res://scripts/ui/busted_screen.gd" id="26_busted"]
[ext_resource type="Script" path="res://scripts/ui/hospital_screen.gd" id="40_hospital"]
[ext_resource type="Script" path="res://scripts/shops/place_director.gd" id="27_places"]
[ext_resource type="Resource" path="res://resources/shops/tiffin.tres" id="28_tiffin"]
[ext_resource type="Resource" path="res://resources/shops/textiles.tres" id="29_textiles"]
[ext_resource type="Resource" path="res://resources/shops/garage.tres" id="30_garage"]
[ext_resource type="Resource" path="res://resources/properties/verandah_house.tres" id="31_house"]
[ext_resource type="Script" path="res://scripts/ui/shop_menu.gd" id="32_shopmenu"]
[ext_resource type="Script" path="res://scripts/shops/shop_data.gd" id="33_shopdata"]
[ext_resource type="Script" path="res://scripts/shops/property_data.gd" id="34_propdata"]
[ext_resource type="Script" path="res://scripts/world/region_watcher.gd" id="35_regions"]
[ext_resource type="Script" path="res://scripts/world/weather_cycle.gd" id="36_weather"]
[ext_resource type="Resource" path="res://resources/world/weather.tres" id="37_weather_settings"]
[ext_resource type="Script" path="res://scripts/world/ambience_director.gd" id="38_ambience"]
[ext_resource type="Resource" path="res://resources/world/ambience.tres" id="39_ambience_settings"]

[node name="Game" type="Node3D"]
script = ExtResource("1_game")

[node name="World" parent="." instance=ExtResource("2_block")]

[node name="Player" parent="." instance=ExtResource("3_player")]

[node name="VehicleCamera" type="Node3D" parent="."]
top_level = true
script = ExtResource("6_vcam")
settings = ExtResource("7_vcamset")

[node name="Yaw" type="Node3D" parent="VehicleCamera"]

[node name="Pitch" type="Node3D" parent="VehicleCamera/Yaw"]

[node name="SpringArm3D" type="SpringArm3D" parent="VehicleCamera/Yaw/Pitch"]
collision_mask = 5
spring_length = 5.6
margin = 0.1

[node name="Camera3D" type="Camera3D" parent="VehicleCamera/Yaw/Pitch/SpringArm3D"]
fov = 72.0

[node name="CameraTransition" type="Camera3D" parent="."]
script = ExtResource("8_transition")

[node name="DayNight" type="Node" parent="."]
script = ExtResource("21_daynight")
settings = ExtResource("22_daynight_settings")

[node name="Gps" type="Node" parent="."]
script = ExtResource("23_gps")

[node name="Traffic" type="Node3D" parent="."]
script = ExtResource("10_traffic")
tuning = ExtResource("12_population")
driver_tuning = ExtResource("13_driver")
car_scene = ExtResource("14_sedan")

[node name="Pedestrians" type="Node3D" parent="."]
script = ExtResource("11_peds")
tuning = ExtResource("12_population")
pedestrian_scene = ExtResource("15_ped")
looks = Array[PackedScene]([ExtResource("16_man"), ExtResource("17_woman"), ExtResource("18_elder")])

[node name="Police" type="Node3D" parent="."]
script = ExtResource("25_police")
car_scene = ExtResource("14_sedan")
officer_look = ExtResource("16_man")

[node name="Missions" type="Node3D" parent="."]
script = ExtResource("19_missions")
looks = Array[PackedScene]([ExtResource("16_man"), ExtResource("17_woman"), ExtResource("18_elder")])

[node name="Places" type="Node3D" parent="."]
script = ExtResource("27_places")
shops = Array[ExtResource("33_shopdata")]([ExtResource("28_tiffin"), ExtResource("29_textiles"), ExtResource("30_garage")])
properties = Array[ExtResource("34_propdata")]([ExtResource("31_house")])

[node name="LaneDebug" type="MeshInstance3D" parent="."]
script = ExtResource("9_lanedebug")

[node name="HUD" parent="." instance=ExtResource("4_hud")]

[node name="PauseMenu" parent="." instance=ExtResource("5_pause")]

[node name="MissionFailed" type="CanvasLayer" parent="."]
process_mode = 3
script = ExtResource("20_failed")

[node name="MapScreen" type="CanvasLayer" parent="."]
process_mode = 3
script = ExtResource("24_map")

[node name="Busted" type="CanvasLayer" parent="."]
process_mode = 3
script = ExtResource("26_busted")

[node name="Hospital" type="CanvasLayer" parent="."]
process_mode = 3
script = ExtResource("40_hospital")

[node name="ShopMenu" type="CanvasLayer" parent="."]
process_mode = 3
script = ExtResource("32_shopmenu")

[node name="Regions" type="Node" parent="."]
script = ExtResource("35_regions")

[node name="Weather" type="Node" parent="."]
script = ExtResource("36_weather")
settings = ExtResource("37_weather_settings")

[node name="Ambience" type="Node" parent="."]
script = ExtResource("38_ambience")
settings = ExtResource("39_ambience_settings")
