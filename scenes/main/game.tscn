[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/systems/game_session.gd" id="1_game"]
[ext_resource type="PackedScene" path="res://scenes/world/old_town.tscn" id="2_block"]
[ext_resource type="PackedScene" path="res://scenes/player/player.tscn" id="3_player"]
[ext_resource type="PackedScene" path="res://scenes/ui/hud.tscn" id="4_hud"]
[ext_resource type="PackedScene" path="res://scenes/ui/pause_menu.tscn" id="5_pause"]
[ext_resource type="Script" path="res://scripts/vehicles/vehicle_camera.gd" id="6_vcam"]
[ext_resource type="Resource" path="res://resources/vehicles/vehicle_camera.tres" id="7_vcamset"]
[ext_resource type="Script" path="res://scripts/systems/camera_transition.gd" id="8_transition"]
[ext_resource type="Script" path="res://scripts/world/lane_graph_debug.gd" id="9_lanedebug"]

[node name="Game" type="Node3D"]
script = ExtResource("1_game")

[node name="World" parent="." instance=ExtResource("2_block")]

[node name="Player" parent="." instance=ExtResource("3_player")]

[node name="VehicleCamera" type="Node3D" parent="."]
top_level = true
script = ExtResource("6_vcam")
settings = ExtResource("7_vcamset")

[node name="Yaw" type="Node3D" parent="VehicleCamera"]

[node name="Pitch" type="Node3D" parent="VehicleCamera/Yaw"]

[node name="SpringArm3D" type="SpringArm3D" parent="VehicleCamera/Yaw/Pitch"]
collision_mask = 5
spring_length = 5.6
margin = 0.1

[node name="Camera3D" type="Camera3D" parent="VehicleCamera/Yaw/Pitch/SpringArm3D"]
fov = 72.0

[node name="CameraTransition" type="Camera3D" parent="."]
script = ExtResource("8_transition")

[node name="LaneDebug" type="MeshInstance3D" parent="."]
script = ExtResource("9_lanedebug")

[node name="HUD" parent="." instance=ExtResource("4_hud")]

[node name="PauseMenu" parent="." instance=ExtResource("5_pause")]
