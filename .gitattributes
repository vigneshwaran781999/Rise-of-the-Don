# Normalise text files to LF in the repo (Godot reads either); shell scripts must stay LF.
* text=auto eol=lf
*.sh text eol=lf

# Binary assets
*.glb binary
*.png binary
*.jpg binary
*.ogg binary
*.wav binary
*.ttf binary
*.otf binary
*.blend binary

# Generated Godot binary scenes and resources (district chunks, baked kit meshes, lane graph)
*.scn binary
*.res binary
