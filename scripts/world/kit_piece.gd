class_name KitPiece
extends Resource
## One building block of a streamed district, baked from a Blender GLB by KitBaker: a single
## surface mesh drawn with the shared palette material, plus convex collision hulls and bounds.
## Lives in res://assets/world/kit/ (generated by tools/godot/build_old_town.gd).

@export var mesh: ArrayMesh
## Convex collision hulls (point clouds) in the piece's own space. Empty for flat ground tiles.
@export var hulls: Array[PackedVector3Array] = []
## Visual bounds in the piece's own space.
@export var bounds: AABB = AABB()
