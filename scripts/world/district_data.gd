class_name DistrictData
extends Resource
## Manifest of one streamed district (GDD §2 world structure): the chunk grid, where its chunk
## scenes live and its lane graph. Generated by tools/godot/build_old_town.gd.

@export var display_name: String = ""
@export var chunk_size: float = 128.0
## World X/Z of the north-west corner of chunk (0, 0).
@export var origin: Vector2 = Vector2.ZERO
@export var chunk_count: Vector2i = Vector2i.ONE
## Path of a chunk scene, formatted with its x and z index.
@export var chunk_path_format: String = ""
@export var lane_graph: LaneGraph

@export_group("Map")
## The district drawn from above (minimap and full map, GDD §11); it covers get_bounds().
@export var map_texture_path: String = ""
## Place names on the full map and where they go (world X/Z).
@export var map_label_texts: PackedStringArray = PackedStringArray()
@export var map_label_positions: PackedVector2Array = PackedVector2Array()


func get_map_texture() -> Texture2D:
	return load(map_texture_path) as Texture2D if map_texture_path != "" and ResourceLoader.exists(map_texture_path) else null


func chunk_path(coord: Vector2i) -> String:
	return chunk_path_format % [coord.x, coord.y]


## The chunk's area as x/z rectangle.
func chunk_rect(coord: Vector2i) -> Rect2:
	return Rect2(origin + Vector2(coord) * chunk_size, Vector2(chunk_size, chunk_size))


func chunk_at(pos: Vector3) -> Vector2i:
	return Vector2i(floori((pos.x - origin.x) / chunk_size), floori((pos.z - origin.y) / chunk_size))


func has_chunk(coord: Vector2i) -> bool:
	return coord.x >= 0 and coord.y >= 0 and coord.x < chunk_count.x and coord.y < chunk_count.y


func get_bounds() -> Rect2:
	return Rect2(origin, Vector2(chunk_count) * chunk_size)


## Horizontal distance from pos to the nearest point of a chunk (0 inside it).
func distance_to_chunk(pos: Vector3, coord: Vector2i) -> float:
	var r: Rect2 = chunk_rect(coord)
	var dx: float = maxf(maxf(r.position.x - pos.x, 0.0), pos.x - r.end.x)
	var dz: float = maxf(maxf(r.position.y - pos.z, 0.0), pos.z - r.end.y)
	return sqrt(dx * dx + dz * dz)
