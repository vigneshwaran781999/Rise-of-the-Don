class_name CityData
extends Resource
## Manifest of the streamed city of Velanagar (GDD §2 world structure): the chunk grid over
## every district, where the chunk scenes live, the one lane graph, the districts (regions),
## police stations and hospitals, the doors of shops and properties, and the map. Generated by
## tools/godot/build_city.gd.

@export var display_name: String = "Velanagar"
@export var chunk_size: float = 128.0
## World X/Z of the north-west corner of chunk (0, 0).
@export var origin: Vector2 = Vector2.ZERO
## Size of the grid around every district; only chunks listed in `chunks` exist.
@export var chunk_count: Vector2i = Vector2i.ONE
## The chunks that have a scene (inside a district).
@export var chunks: Array[Vector2i] = []
## Path of a chunk scene, formatted with its x and z index.
@export var chunk_path_format: String = ""
@export var lane_graph: LaneGraph
## Where you are released after an arrest (GDD §7), each facing its -Z (out of the door).
@export var police_stations: Array[Transform3D] = []
## Where you wake after being knocked out (M7): hospital and clinic doors, each facing its -Z.
@export var hospitals: Array[Transform3D] = []
## Spots at the doors of shops and properties (on the sidewalk, facing out), by place id.
@export var places: Dictionary = {}

@export_group("Districts")
## The districts, by index: id (save data, ambience), name (shown on arrival and on the map)
## and their square (world x/z).
@export var region_ids: PackedStringArray = PackedStringArray()
@export var region_names: PackedStringArray = PackedStringArray()
@export var region_rects: Array[Rect2] = []

@export_group("Map")
## The city drawn from above (minimap and full map, GDD §11); it covers get_bounds().
@export var map_texture_path: String = ""
## Place names on the full map and where they go (world X/Z).
@export var map_label_texts: PackedStringArray = PackedStringArray()
@export var map_label_positions: PackedVector2Array = PackedVector2Array()

@export_group("Surfaces")
## What the ground is made of, one pixel per metre over get_bounds() (an Image; a SURFACES index in
## the red channel). Footsteps sound different on each (M7).
@export var surface_map_path: String = ""

## The ground surfaces the surface map knows, by index.
const SURFACES: Array[StringName] = [&"road", &"paved", &"sand", &"grass", &"wood", &"water"]

var _chunk_set: Dictionary = {}
var _surfaces: Image


func get_map_texture() -> Texture2D:
	return load(map_texture_path) as Texture2D if map_texture_path != "" and ResourceLoader.exists(map_texture_path) else null


func chunk_path(coord: Vector2i) -> String:
	return chunk_path_format % [coord.x, coord.y]


## The chunk's area as x/z rectangle.
func chunk_rect(coord: Vector2i) -> Rect2:
	return Rect2(origin + Vector2(coord) * chunk_size, Vector2(chunk_size, chunk_size))


func chunk_at(pos: Vector3) -> Vector2i:
	return Vector2i(floori((pos.x - origin.x) / chunk_size), floori((pos.z - origin.y) / chunk_size))


func has_chunk(coord: Vector2i) -> bool:
	if _chunk_set.size() != chunks.size():
		_chunk_set.clear()
		for c: Vector2i in chunks:
			_chunk_set[c] = true
	return _chunk_set.has(coord)


func get_bounds() -> Rect2:
	return Rect2(origin, Vector2(chunk_count) * chunk_size)


## Horizontal distance from pos to the nearest point of a chunk (0 inside it).
func distance_to_chunk(pos: Vector3, coord: Vector2i) -> float:
	var r: Rect2 = chunk_rect(coord)
	var dx: float = maxf(maxf(r.position.x - pos.x, 0.0), pos.x - r.end.x)
	var dz: float = maxf(maxf(r.position.y - pos.z, 0.0), pos.z - r.end.y)
	return sqrt(dx * dx + dz * dz)


## Index of the district at pos (world x/z), or -1 outside every district.
func region_at(pos: Vector3) -> int:
	for i: int in region_rects.size():
		if region_rects[i].has_point(Vector2(pos.x, pos.z)):
			return i
	return -1


func get_region_name(index: int) -> String:
	return region_names[index] if index >= 0 and index < region_names.size() else ""


func get_region_id(index: int) -> StringName:
	return StringName(region_ids[index]) if index >= 0 and index < region_ids.size() else &""


## The police station door nearest pos (where an arrest there ends), or an identity transform
## when the city has none.
func nearest_police_station(pos: Vector3) -> Transform3D:
	return _nearest(police_stations, pos)


## The hospital or clinic door nearest pos (where the player wakes after being knocked out), or
## an identity transform when the city has none.
func nearest_hospital(pos: Vector3) -> Transform3D:
	return _nearest(hospitals, pos)


static func _nearest(spots: Array[Transform3D], pos: Vector3) -> Transform3D:
	var best := Transform3D()
	var best_d: float = INF
	for spot: Transform3D in spots:
		var d: float = spot.origin.distance_squared_to(pos)
		if d < best_d:
			best_d = d
			best = spot
	return best


## What the ground is made of at pos (one of SURFACES): &"paved" where the city has no surface map.
func surface_at(pos: Vector3) -> StringName:
	if _surfaces == null:
		if surface_map_path == "" or not ResourceLoader.exists(surface_map_path):
			return &"paved"
		_surfaces = load(surface_map_path) as Image
	var b: Rect2 = get_bounds()
	var x: int = clampi(int(pos.x - b.position.x), 0, _surfaces.get_width() - 1)
	var y: int = clampi(int(pos.z - b.position.y), 0, _surfaces.get_height() - 1)
	var index: int = int(round(_surfaces.get_pixel(x, y).r * 255.0))
	return SURFACES[index] if index < SURFACES.size() else &"paved"
